# Cloudflare Pages headers. Applied to the static export in out/.

# Hashed build assets never change — cache hard.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts
/_next/static/media/*
  Cache-Control: public, max-age=31536000, immutable

# Sensible defaults for every page.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: browser=(), geolocation=()

# Cloudflare Workers static assets: the generated share card has no extension (Next metadata route),
# so say it is a PNG; some crawlers (Facebook, Discord) drop images served as octet-stream.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=86400
